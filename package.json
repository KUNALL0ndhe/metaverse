{
  "name": "metaverse",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=client --filter=realtime",
    "build": "turbo run build --filter=client --filter=realtime",
    "start": "pnpm --filter realtime start",
    "map:import": "pnpm --filter @repo/world map:import",
    "map:generate": "pnpm --filter @repo/world map:generate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "share": "pnpm build && node scripts/share.mjs",
    "map:spots": "pnpm --filter @repo/world map:spots"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
