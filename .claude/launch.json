{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "realtime",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "realtime",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "client",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/realtime/dist/index.js"
      ],
      "env": {
        "PORT": "8090"
      },
      "port": 8090
    }
  ]
}
